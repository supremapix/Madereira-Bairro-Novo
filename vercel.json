{
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/produto/madeira-de-pinus",
      "destination": "/madeira-de-pinus",
      "statusCode": 301
    },
    {
      "source": "/bairro/jardim-gabineto",
      "destination": "/bairro/gabineto",
      "statusCode": 301
    },
    {
      "source": "/bairro/cic-\\(cidade-industrial-de-curitiba\\)",
      "destination": "/bairro/cic",
      "statusCode": 301
    },
    {
      "source": "/bairro/cic-%28cidade-industrial-de-curitiba%29",
      "destination": "/bairro/cic",
      "statusCode": 301
    },
    {
      "source": "/bairro/cic-cidade-industrial-de-curitiba",
      "destination": "/bairro/cic",
      "statusCode": 301
    },
    {
      "source": "/sitemap-pages.xml",
      "destination": "/sitemap.xml",
      "statusCode": 301
    },
    {
      "source": "/sitemap-products.xml",
      "destination": "/sitemap.xml",
      "statusCode": 301
    },
    {
      "source": "/sitemap-blog.xml",
      "destination": "/sitemap.xml",
      "statusCode": 301
    },
    {
      "source": "/sitemap-images.xml",
      "destination": "/sitemap.xml",
      "statusCode": 301
    },
    {
      "source": "/sitemap-locations.xml",
      "destination": "/sitemap.xml",
      "statusCode": 301
    }
  ]
}
